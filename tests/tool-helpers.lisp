(in-package #:cl-llm-provider-api/tests)

(defun test-tool-helpers ()
  "Exercise provider identifier, schema, and namespace helper contracts."
  (let* ((mapping    (provider-tool-identifier-map
                      '("hello world" "9 lives" "žluťoučký")
                      :identity-scope "server"))
         (identifier (gethash "hello world" mapping)))
    (check (<= (length identifier) *provider-chat-completions-tool-identifier-limit*)
           "identifier exceeded the provider character budget")
    (check (string= (subseq identifier 0 12) "hello_world_")
           "identifier no longer has the stable readable prefix: ~A" identifier)
    (check (every (lambda (character)
                    (or (alphanumericp character)
                        (member character '(#\_ #\-) :test #'char=)))
                  identifier)
           "identifier contains a non-provider-safe character")
    (check (equalp mapping
                   (provider-tool-identifier-map
                    '("žluťoučký" "9 lives" "hello world")
                    :identity-scope "server"))
           "identifier mapping depends on discovery order")
    (check (string= identifier "hello_world_53F16F219F")
           "scoped UTF-8 FNV identifier does not match its stable identity")
    (check (not (equal (gethash "hello world" mapping)
                       (gethash "hello world"
                                (provider-tool-identifier-map
                                 '("hello world") :identity-scope "other"))))
           "identity scope did not affect the hash")
    (check (handler-case
               (progn (provider-tool-identifier-map '("same" "same")) nil)
             (provider-tool-identifier-duplicate-error () t))
           "duplicate raw names were not typed")
    (check (handler-case
               (progn (provider-tool-identifier-map '("x") :limit 11) nil)
             (provider-tool-identifier-limit-error () t))
           "minimum limit was not enforced")
    (check (handler-case
               (progn (provider-tool-identifier-map '("x") :limit 24) nil)
             (provider-tool-identifier-limit-error () t))
           "maximum limit was not enforced")
    (check (handler-case
               (progn (provider-tool-identifier-map '("x") :prefix "bad.prefix") nil)
             (provider-tool-identifier-error () t))
           "unsafe prefix was silently accepted")
    (check (search "unnamed_" (gethash "" (provider-tool-identifier-map '(""))))
           "empty raw names did not receive a safe base")
    (dolist (prefix '("é" "ascii_é"))
      (check (handler-case
                 (progn (provider-tool-identifier-map '("x") :prefix prefix) nil)
               (provider-tool-identifier-error () t))
             "a non-ASCII prefix was accepted"))
    (let* ((namespace
             (gethash "x000001"
                      (provider-tool-identifier-map '("x000001") :prefix "mcp__")))
           (name
             (gethash "_x000001_"
                      (provider-tool-identifier-map '("_x000001_")
                                                    :identity-scope "x000001")))
           (wire (provider-wire-function-name--encode namespace name)))
      (check (<= (length wire) *provider-wire-function-name-maximum-length*)
             "reserved escape spelling exceeded the combined wire-name budget")
      (check (equal (multiple-value-list (provider-wire-function-name--decode wire))
                    (list namespace name))
             "reserved escape spelling changed a decoded identity"))
    (let ((original (symbol-function 'cl-llm-provider-api::provider-tool-identifier--hash)))
      (unwind-protect
           (progn
             (setf (symbol-function 'cl-llm-provider-api::provider-tool-identifier--hash)
                   (lambda (raw)
                     (declare (ignore raw))
                     "0000000000000000"))
             (check (handler-case
                        (progn
                          (provider-tool-identifier-map '("hello world" "hello/world"))
                          nil)
                      (provider-tool-identifier-collision-error () t))
                    "a hash collision did not produce a typed identifier failure"))
        (setf (symbol-function 'cl-llm-provider-api::provider-tool-identifier--hash)
              original))))
  (let* ((properties (cl-llm-provider-api::json-object "a" (provider-string-property "A")
                                  "flag" (provider-boolean-property "Flag")))
         (closed     (provider-object-schema properties '("a")))
         (open       (provider-open-object-schema properties :required '("a")))
         (false-args (cl-llm-provider-api::json-object "a" cl-llm-provider-api::*json-decoded-false*)))
    (check (eq (gethash "additionalProperties" closed) cl-llm-provider-api::*json-decoded-false*)
           "closed schema was not closed")
    (check (null (gethash "additionalProperties" open))
           "open schema unexpectedly declared additional properties")
    (check (null (provider-schema-missing-required-names closed false-args))
           "false-valued required property was treated as absent")
    (check (equal (provider-schema-missing-required-names closed (cl-llm-provider-api::json-object)) '("a"))
           "missing required property was not reported")
    (check (null (provider-schema-required-names
                  (cl-llm-provider-api::json-object "required" "not-an-array")))
           "string required value was accepted as an array")
    (check (equal (provider-schema-argument-placeholder
                   (cl-llm-provider-api::json-object "type" "string")) "")
           "string placeholder was not conservative")
    (check (eq (provider-schema-argument-placeholder
                (cl-llm-provider-api::json-object "type" "boolean")) cl-llm-provider-api::*json-decoded-false*)
           "boolean placeholder was not false")
    (check (equal (provider-schema-argument-placeholder
                   (cl-llm-provider-api::json-object "type" "string" "enum" #())) "")
           "an empty enum suppressed the type-based retry placeholder")
   (dolist (operator '("oneOf" "anyOf"))
     (let ((schema (cl-llm-provider-api::json-object
                    "required" #("base")
                    operator (vector
                              (cl-llm-provider-api::json-object "required" #("left"))
                              (cl-llm-provider-api::json-object "required" #("right"))))))
       (check (equal (provider-schema-required-groups schema)
                     '(("base" "left") ("base" "right")))
              "~A groups were not combined with base requirements" operator)
       (check (equal (provider-schema-missing-required-names
                      schema (cl-llm-provider-api::json-object "base" nil))
                     '(:one-of "left" "right"))
              "~A alternatives did not produce a minimal diagnostic" operator)))
   (let* ((calls  0)
          (groups (provider-group-tool-schemas
                   '(:a :b :c)
                   :namespace-function   (lambda (tool) (if (eq tool :c) "two" "one"))
                   :name-function        (lambda (tool) (string-downcase (symbol-name tool)))
                   :schema-function      (lambda (tool) (incf calls) tool)
                   :description-function (lambda (namespace)
                                           (format nil "description-~A" namespace)))))
     (check (= calls 3) "schema callback did not run once per tool")
     (check (equalp (map 'list (lambda (group) (gethash "name" group)) groups)
                    '("one" "two"))
            "namespace order was not first-encounter order")
     (check (equalp (coerce (gethash "tools" (aref groups 0)) 'list) '(:a :b))
            "tool order was not first-encounter order")
     (check (string= (gethash "description" (aref groups 0)) "description-one")
            "namespace description was not applied once")
     (check (zerop (length (provider-group-tool-schemas
                            '(:a) :canonical-names nil
                            :namespace-function    (lambda (tool) (declare (ignore tool)) "one")
                            :name-function         (lambda (tool) (declare (ignore tool)) "a")
                            :schema-function       #'identity)))
            "explicit NIL canonical filter was not empty"))
   (let ((array     (provider-array-schema (provider-string-property "item")))
         (enum      (provider-enum-schema '("a" "b") nil))
         (described (provider-enum-schema #("a") "choose one")))
     (check (equal (gethash "type" array) "array") "array schema type was wrong")
     (check (equalp (gethash "enum" enum) #( "a" "b")) "enum values were not vectors")
     (check (null (gethash "description" enum)) "NIL description changed schema shape")
     (check (string= (gethash "description" described) "choose one")
            "enum description was lost"))))

(defun test-tool-argument-contracts ()
  "Check structural diagnostics and selected field contracts without mutating inputs."
  (let* ((properties (json-object "path" (provider-string-property "Path")
                                  "mode" (provider-string-property "Mode")))
         (schema     (provider-object-schema properties '("path")))
         (arguments  (json-object "pah" (json-object "nested" #(1 2)) "z" nil))
         (diagnostic (cl-llm-provider-api:provider-schema-argument-diagnostic schema arguments))
         (retry      (cl-llm-provider-api:provider-schema-argument-retry schema arguments diagnostic)))
    (check (eq (cl-llm-provider-api:provider-argument-diagnostic-code diagnostic) :unknown-arguments)
           "unknown keys did not precede missing keys")
    (check (equal (cl-llm-provider-api:provider-argument-diagnostic-names diagnostic) '("pah" "z"))
           "unknown names were not ordered")
    (check (equalp (gethash "path" retry) (gethash "pah" arguments)) "retry lost the supplied value")
    (setf (aref (gethash "nested" (gethash "path" retry)) 0) 9)
    (check (= 1 (aref (gethash "nested" (gethash "pah" arguments)) 0)) "retry shared nested input")
    (check (not (nth-value 1 (gethash "path" arguments))) "retry changed the input keys")
    (dolist (arguments (list (json-object "pah" "typo" "path" "explicit")
                            (json-object "pah" "first" "pth" "second")))
      (let* ((diagnostic (cl-llm-provider-api:provider-schema-argument-diagnostic schema arguments))
             (retry      (cl-llm-provider-api:provider-schema-argument-retry schema arguments diagnostic)))
        (check (equalp arguments retry) "retry overwrote an explicit or colliding target")))
    (let* ((tie-schema (provider-object-schema (json-object "cat" properties "bat" properties) nil))
           (diagnostic (cl-llm-provider-api:provider-schema-argument-diagnostic tie-schema (json-object "hat" t))))
      (check (null (rest (assoc "hat" (cl-llm-provider-api:provider-argument-diagnostic-suggestions diagnostic)
                              :test #'equal))) "ambiguous spelling produced a suggestion"))
    (dolist (additional (list t nil (json-object "type" "string")))
      (let ((open (cl-llm-provider-api::json-object-copy schema)))
        (setf (gethash "additionalProperties" open) additional)
        (check (null (cl-llm-provider-api:provider-schema-argument-diagnostic open (json-object "path" nil "extra" t)))
               "open object rejected an unknown key")))
    (let ((pattern (cl-llm-provider-api::json-object-copy schema)))
      (setf (gethash "patternProperties" pattern) (json-object "x.*" (json-object)))
      (check (null (cl-llm-provider-api:provider-schema-argument-diagnostic pattern (json-object "path" nil "extra" t)))
             "pattern schema rejected an unknown key"))
    (check (null (cl-llm-provider-api:provider-schema-argument-diagnostic schema (json-object "path" :json-false)))
           "false did not count as supplied")
    (check (null (cl-llm-provider-api:provider-schema-argument-diagnostic
                  schema (json-object "path" nil "metadata" t) :allowed-extra-names '("metadata")))
           "allowed metadata was rejected")
    (dolist (operator '("oneOf" "anyOf"))
      (let* ((alternatives (json-object operator (vector (json-object "required" #("a"))
                                                        (json-object "required" #("b")))))
             (diagnostic   (cl-llm-provider-api:provider-schema-argument-diagnostic alternatives (json-object))))
        (check (eq (cl-llm-provider-api:provider-argument-diagnostic-operator diagnostic)
                   (if (equal operator "oneOf") :one-of :any-of)) "alternative operator was lost")
        (check (equal (cl-llm-provider-api:provider-argument-diagnostic-groups diagnostic) '(("a") ("b")))
               "alternative groups were lost"))))
  (dolist (case '((("type" "integer" "minimum" 1 "maximum" 3 "default" 2) 1 nil)
                  (("type" "integer" "minimum" 1 "maximum" 3) 3 nil)
                  (("type" "integer" "minimum" 1) 0 :out-of-range)
                  (("type" "integer" "maximum" 3) 4 :out-of-range)
                  (("type" "integer") "1" :invalid-type)
                  (("type" "boolean" "default" t) :json-false nil)
                  (("type" "boolean" "default" t) nil :invalid-type)
                  (("type" "string" "enum" #("a" "b")) "c" :invalid-enum)
                  (("type" "string" "minLength" 1) "" :invalid-length)
                  (("type" "integer" "multipleOf" 2) 2 :unsupported-contract)))
    (destructuring-bind (fields value expected) case
      (let* ((field     (apply #'json-object fields))
             (schema    (provider-object-schema (json-object "field" field) nil))
             (arguments (json-object "field" value)))
        (multiple-value-bind (actual supplied-p diagnostic)
            (cl-llm-provider-api:provider-schema-argument-value schema arguments "field")
          (check (equal actual value) "supplied value changed")
          (check supplied-p "supplied flag lost")
          (check (eq expected (and diagnostic (cl-llm-provider-api:provider-argument-diagnostic-code diagnostic)))
                 "wrong diagnostic for ~S: ~S" fields diagnostic)
          (when diagnostic
            (check (equal (cl-llm-provider-api:provider-argument-diagnostic-path diagnostic)
                          (if (eq expected :unsupported-contract) '("field" "multipleOf") '("field")))
                   "field diagnostic path lost"))))))
  (let* ((field  (json-object "type" "array" "maxItems" 2 "items"
                             (json-object "type" "integer" "minimum" 1 "maximum" 100000000)
                             "default" #(1)))
         (schema (provider-object-schema (json-object "lines" field) nil)))
    (dolist (case (list (list #() nil) (list #(1 1) nil) (list "1" :invalid-type)
                       (list '(1) :invalid-type) (list #(1 2 3) :invalid-length)
                       (list #(1 0) :out-of-range) (list #(100000001) :out-of-range)))
      (multiple-value-bind (value supplied-p diagnostic)
          (cl-llm-provider-api:provider-schema-argument-value schema (json-object "lines" (first case)) "lines")
        (declare (ignore value supplied-p))
        (check (eq (second case) (and diagnostic (cl-llm-provider-api:provider-argument-diagnostic-code diagnostic)))
               "array contract mismatch")
        (when (equalp (first case) #(1 0))
          (check (equal (cl-llm-provider-api:provider-argument-diagnostic-path diagnostic) '("lines" 1))
                 "array item path lost"))))
    (multiple-value-bind (value supplied-p diagnostic)
        (cl-llm-provider-api:provider-schema-argument-value schema (json-object) "lines")
      (check (and (not supplied-p) (not diagnostic) (equalp value #(1))) "absent default not selected")
      (setf (aref value 0) 9)
      (check (= 1 (aref (gethash "default" field) 0)) "default shared schema storage"))
    (setf (gethash "default" field) #(0))
    (check (eq :out-of-range
               (cl-llm-provider-api:provider-argument-diagnostic-code
                (nth-value 2 (cl-llm-provider-api:provider-schema-argument-value schema (json-object) "lines"))))
           "invalid default was not checked")
    (remhash "default" field)
    (check (equal '(nil nil nil)
                  (multiple-value-list (cl-llm-provider-api:provider-schema-argument-value schema (json-object) "lines")))
           "absent optional value was defaulted")))

(defun test-tool-argument-edge-contracts ()
  "Exercise malformed contracts, nullable values and detached stale-diagnostic retries."
  (dolist (field (list (json-object "type" "string" "minimum" 1)
                       (json-object "type" "string" "minItems" 1)
                       (json-object "type" "array" "minLength" 1)
                       (json-object "type" "array" "items" (json-object "type" "object"))))
    (let* ((schema (json-object "properties" (json-object "value" field)))
           (value  (if (equal "array" (gethash "type" field)) #() "a")))
      (check (eq :unsupported-contract
                 (cl-llm-provider-api:provider-argument-diagnostic-code
                  (nth-value 2 (cl-llm-provider-api:provider-schema-argument-value
                                schema (json-object "value" value) "value"))))
             "incompatible assertion was accepted: ~S" field)))
  (let* ((field  (json-object "type" #("boolean" "null") "default" t))
         (schema (json-object "properties" (json-object "value" field))))
    (check (equal '(t nil nil) (multiple-value-list
                                (cl-llm-provider-api:provider-schema-argument-value schema (json-object) "value")))
           "absent nullable boolean did not default")
    (dolist (value (list nil :json-false yason:false t))
      (check (equal (list value t nil) (multiple-value-list
                                        (cl-llm-provider-api:provider-schema-argument-value
                                         schema (json-object "value" value) "value")))
             "explicit nullable boolean changed: ~S" value))
    (check (eq :invalid-type
               (cl-llm-provider-api:provider-argument-diagnostic-code
                (nth-value 2 (cl-llm-provider-api:provider-schema-argument-value
                              schema (json-object "value" "false") "value"))))
           "malformed nullable boolean accepted"))
  (let ((schema (json-object "properties" (json-object "kind" (json-object "type" "string" "enum" #("in" "out"))))))
    (check (eq :invalid-enum
               (cl-llm-provider-api:provider-argument-diagnostic-code
                (nth-value 2 (cl-llm-provider-api:provider-schema-argument-value
                              schema (json-object "kind" "IN") "kind"))))
           "enum strings compared case-insensitively"))
  (let* ((key     (copy-seq "path"))
         (schema  (json-object "type" "object" "properties" (json-object key (json-object "type" "string"))
                               "required" #("path")))
         (missing (cl-llm-provider-api:provider-schema-argument-diagnostic schema (json-object))))
    (check (null (cl-llm-provider-api:provider-schema-argument-diagnostic schema (json-object "extra" 1 "path" "a")))
           "absent additionalProperties closed the schema")
    (let* ((arguments (json-object "path" "explicit"))
           (retry     (cl-llm-provider-api:provider-schema-argument-retry schema arguments missing)))
      (check (equal "explicit" (gethash "path" retry)) "stale missing diagnostic overwrote an explicit value"))
    (let* ((retry     (cl-llm-provider-api:provider-schema-argument-retry schema (json-object) missing))
           (retry-key (loop for name being the hash-keys of retry return name)))
      (check (equal "path" retry-key) "missing retry omitted its required field")
      (check (stringp (gethash "path" retry)) "missing retry lost its string placeholder")
      (check (not (eq key retry-key)) "retry key aliases the schema")
      (check (not (eq (first (cl-llm-provider-api:provider-argument-diagnostic-names missing)) retry-key))
             "retry key aliases the diagnostic"))
    (setf (gethash "additionalProperties" schema) yason:false)
    (let* ((unknown (cl-llm-provider-api:provider-schema-argument-diagnostic schema (json-object "pah" "a")))
           (retry   (cl-llm-provider-api:provider-schema-argument-retry schema (json-object) unknown)))
      (check (eq :unknown-arguments (cl-llm-provider-api:provider-argument-diagnostic-code unknown))
             "Yason false did not close schema")
      (check (zerop (hash-table-count retry)) "stale unknown diagnostic inserted a vanished value"))
    (let* ((argument-key (copy-seq "path"))
           (arguments    (json-object argument-key (json-object (copy-seq "nested") "value")))
           (retry        (cl-llm-provider-api:provider-schema-argument-retry schema arguments missing)))
      (check (equal "value" (gethash "nested" (gethash "path" retry)))
             "nested retry copy lost its supplied payload")
      (check (not (eq argument-key (loop for name being the hash-keys of retry return name)))
             "copied object key aliases original")
      (check (not (eq (loop for name being the hash-keys of (gethash "path" arguments) return name)
                      (loop for name being the hash-keys of (gethash "path" retry) return name)))
             "nested copied key aliases original"))))
